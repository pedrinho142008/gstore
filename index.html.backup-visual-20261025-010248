<script>
/* GSTORE — CONFIGURAÇÃO
   Troque INSTAGRAM_URL pelo endereço real do perfil da loja.
*/
const INSTAGRAM_URL = "https://www.instagram.com/";

const imageFiles = [
"gstore_cm_20261025_002803142.jpg",
"gstore_cm_20261025_002805993.jpg",
"gstore_cm_20261025_002809350.jpg",
"gstore_cm_20261025_002814860.jpg",
"gstore_cm_20261025_002817251.jpg",
"gstore_cm_20261025_002820490.jpg",
"gstore_cm_20261025_002823664.jpg",
"gstore_cm_20261025_002827827.jpg",
"gstore_cm_20261025_002830079.jpg",
"gstore_cm_20261025_002832620.jpg",
"gstore_cm_20261025_002834736.jpg",
"gstore_cm_20261025_002836890.jpg",
"gstore_cm_20261025_002839261.jpg",
"gstore_cm_20261025_002842420.jpg",
"gstore_cm_20261025_002844860.jpg",
"gstore_cm_20261025_002859810.jpg",
"gstore_cm_20261025_002902260.jpg",
"gstore_cm_20261025_002904530.jpg",
"gstore_cm_20261025_002918061.jpg",
"gstore_cm_20261025_002920470.jpg",
"gstore_cm_20261025_002923136.jpg",
"gstore_cm_20261025_002927185.jpg",
"gstore_cm_20261025_002928462.jpg",
"gstore_cm_20261025_002932447.jpg",
"gstore_cm_20261025_002935688.jpg",
"gstore_cm_20261025_003001977.jpg",
"leilacristina_divulg_20261025_002942330.jpg"
];

const products = imageFiles.map((file, index) => ({
  id: index + 1,
  name: `Peça GStore ${String(index + 1).padStart(2, "0")}`,
  file,
  image: `public/images/${file}`,
  isNew: index >= imageFiles.length - 8,
  search: `peça gstore look moda roupa ${String(index + 1).padStart(2, "0")}`
}));

let favorites = [];
try {
  favorites = JSON.parse(localStorage.getItem("gstore_favorites") || "[]");
  if (!Array.isArray(favorites)) favorites = [];
} catch (_) { favorites = []; }

let currentFilter = "all";
let activeProduct = null;

const grid = document.getElementById("productGrid");
const searchInput = document.getElementById("searchInput");
const sortSelect = document.getElementById("sortSelect");
const meta = document.getElementById("catalogMeta");
const modal = document.getElementById("productModal");
const toast = document.getElementById("toast");

function saveFavorites() {
  try { localStorage.setItem("gstore_favorites", JSON.stringify(favorites)); }
  catch (_) {}
  document.getElementById("favoriteCount").textContent = favorites.length;
}
function notify(message) {
  toast.textContent = message;
  toast.classList.add("show");
  clearTimeout(notify.timer);
  notify.timer = setTimeout(() => toast.classList.remove("show"), 2300);
}
function escapeHTML(value) {
  return String(value).replace(/[&<>"']/g, char => ({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
  })[char]);
}
function getFilteredProducts() {
  const query = searchInput.value.trim().toLocaleLowerCase("pt-BR");
  let list = products.filter(p => {
    const matchesQuery = `${p.name} ${p.search} ${p.file}`.toLocaleLowerCase("pt-BR").includes(query);
    const matchesFilter =
      currentFilter === "all" ||
      (currentFilter === "new" && p.isNew) ||
      (currentFilter === "favorites" && favorites.includes(p.id));
    return matchesQuery && matchesFilter;
  });
  if (sortSelect.value === "az") list.sort((a,b) => a.name.localeCompare(b.name,"pt-BR"));
  if (sortSelect.value === "za") list.sort((a,b) => b.name.localeCompare(a.name,"pt-BR"));
  return list;
}
function renderProducts() {
  const list = getFilteredProducts();
  meta.textContent = `${list.length} ${list.length === 1 ? "peça encontrada" : "peças encontradas"}`;
  if (!list.length) {
    grid.innerHTML = `<div class="empty"><strong>Nenhuma peça encontrada</strong>
      Tente outra busca ou confira os filtros selecionados.<br><br>
      <button class="btn btn-dark" id="clearFilters">Limpar filtros</button></div>`;
    document.getElementById("clearFilters").addEventListener("click", () => {
      searchInput.value = ""; currentFilter = "all"; sortSelect.value = "default";
      document.querySelectorAll(".tab").forEach(b => b.classList.toggle("active", b.dataset.filter === "all"));
      renderProducts();
    });
    return;
  }
  grid.innerHTML = list.map((p, index) => `
    <article class="product" tabindex="0" role="button" data-open="${p.id}"
      aria-label="Ver ${p.name}" style="animation-delay:${Math.min(index,12)*25}ms">
      <div class="product-photo">
        <img src="${p.image}" alt="${p.name}" loading="lazy"
          onerror="this.onerror=null;this.src='public/images/Logo.png';this.style.objectFit='contain';this.style.padding='25px'">
        <button class="favorite ${favorites.includes(p.id) ? "saved" : ""}"
          data-favorite="${p.id}" aria-label="${favorites.includes(p.id) ? "Remover dos favoritos" : "Adicionar aos favoritos"}"
          aria-pressed="${favorites.includes(p.id)}">${favorites.includes(p.id) ? "♥" : "♡"}</button>
        <button class="quickview" data-open="${p.id}">VER DETALHES ↗</button>
      </div>
      <div class="product-info"><small>${p.isNew ? "✦ NOVIDADE" : "COLEÇÃO GSTORE"}</small>
        <h3>${p.name}</h3><p>Descubra os detalhes desta peça</p></div>
    </article>`).join("");
}
function toggleFavorite(id) {
  if (favorites.includes(id)) {
    favorites = favorites.filter(n => n !== id);
    notify("Peça removida dos favoritos.");
  } else {
    favorites.push(id);
    notify("Peça adicionada aos favoritos ♥");
  }
  saveFavorites();
  renderProducts();
  if (activeProduct && activeProduct.id === id) updateModalFavorite();
}
function openProduct(id) {
  const p = products.find(item => item.id === id);
  if (!p) return;
  activeProduct = p;
  document.getElementById("modalImage").src = p.image;
  document.getElementById("modalImage").alt = p.name;
  document.getElementById("modalName").textContent = p.name;
  document.getElementById("modalDescription").textContent =
    p.isNew ? "Uma das novidades da GStore. Entre em contato ou visite nossa loja para conhecer esta peça de perto."
    : "Uma peça da coleção GStore para inspirar novas combinações e expressar seu estilo.";
  updateModalFavorite();
  modal.classList.add("open");
  document.body.classList.add("locked");
  document.getElementById("modalClose").focus();
}
function updateModalFavorite() {
  if (!activeProduct) return;
  const saved = favorites.includes(activeProduct.id);
  const button = document.getElementById("modalFavorite");
  button.textContent = saved ? "♥ Remover dos favoritos" : "♡ Adicionar aos favoritos";
}
function closeModal() {
  modal.classList.remove("open");
  document.body.classList.remove("locked");
}
grid.addEventListener("click", event => {
  const favoriteButton = event.target.closest("[data-favorite]");
  if (favoriteButton) {
    event.stopPropagation();
    toggleFavorite(Number(favoriteButton.dataset.favorite));
    return;
  }
  const openButton = event.target.closest("[data-open]");
  if (openButton) openProduct(Number(openButton.dataset.open));
});
grid.addEventListener("keydown", event => {
  if ((event.key === "Enter" || event.key === " ") && event.target.matches(".product")) {
    event.preventDefault(); openProduct(Number(event.target.dataset.open));
  }
});
document.querySelectorAll(".tab").forEach(button => {
  button.addEventListener("click", () => {
    currentFilter = button.dataset.filter;
    document.querySelectorAll(".tab").forEach(b => b.classList.toggle("active", b === button));
    renderProducts();
    if (currentFilter === "favorites") document.getElementById("produtos").scrollIntoView({behavior:"smooth"});
  });
});
searchInput.addEventListener("input", renderProducts);
sortSelect.addEventListener("change", renderProducts);
document.getElementById("headerSearch").addEventListener("click", () => {
  document.getElementById("produtos").scrollIntoView({behavior:"smooth"});
  setTimeout(() => searchInput.focus(), 400);
});
document.getElementById("headerFavorites").addEventListener("click", () => {
  currentFilter = "favorites";
  document.querySelectorAll(".tab").forEach(b => b.classList.toggle("active", b.dataset.filter === "favorites"));
  renderProducts();
  document.getElementById("produtos").scrollIntoView({behavior:"smooth"});
});
document.getElementById("modalFavorite").addEventListener("click", () => {
  if (activeProduct) toggleFavorite(activeProduct.id);
});
document.getElementById("modalClose").addEventListener("click", closeModal);
modal.addEventListener("click", event => { if (event.target === modal) closeModal(); });
document.addEventListener("keydown", event => { if (event.key === "Escape") closeModal(); });

const menuToggle = document.getElementById("menuToggle");
const mobileMenu = document.getElementById("mobileMenu");
menuToggle.addEventListener("click", () => {
  const opened = mobileMenu.classList.toggle("open");
  menuToggle.textContent = opened ? "×" : "☰";
  menuToggle.setAttribute("aria-expanded", String(opened));
});
mobileMenu.querySelectorAll("a").forEach(link => link.addEventListener("click", () => {
  mobileMenu.classList.remove("open");
  menuToggle.textContent = "☰";
  menuToggle.setAttribute("aria-expanded", "false");
}));

document.getElementById("instagramLink").href = INSTAGRAM_URL;
document.getElementById("year").textContent = new Date().getFullYear();
saveFavorites();
renderProducts();
</script>

