<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#171717">
<meta name="description" content="GStore Ceará-Mirim — moda, estilo e peças exclusivas para valorizar sua beleza.">
<title>GStore | Vista-se de confiança</title>
<style>
:root{
  --bg:#faf8f5;--paper:#fff;--ink:#191919;--muted:#77716b;
  --line:#e9e4de;--accent:#a57a56;--soft:#eee5dc;
  --radius:20px;--shadow:0 12px 40px #25180d0b;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:95px}
body{margin:0;background:var(--bg);color:var(--ink);
  font-family:Arial,Helvetica,sans-serif;line-height:1.55}
body.locked{overflow:hidden}
a{color:inherit;text-decoration:none}
button,input,select{font:inherit}
button{cursor:pointer}
button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{
  outline:2px solid var(--accent);outline-offset:4px}
img{max-width:100%;display:block}
.container{width:min(1200px,92%);margin:auto}
.announcement{background:#191919;color:#fff;text-align:center;
  padding:9px 12px;font-size:11px;letter-spacing:1.8px;text-transform:uppercase}
header{position:sticky;top:0;z-index:20;background:#faf8f5ed;
  backdrop-filter:blur(18px);border-bottom:1px solid #e9e4de}
.nav{min-height:88px;display:flex;align-items:center;justify-content:flex-start;gap:18px}
.brand{display:flex;align-items:center;min-width:90px}
.brand img{width:150px;height:78px;object-fit:contain}
.navlinks{display:flex;gap:22px;align-items:center;font-size:12px;font-weight:700;flex:1}
.navlinks a{transition:color .2s}
.navlinks a:hover{color:var(--accent)}
.navright{display:flex;align-items:center;gap:9px}
.iconbtn{width:40px;height:40px;border:1px solid var(--line);border-radius:50%;
  display:grid;place-items:center;background:transparent;font-size:18px;position:relative}
.count{position:absolute;right:-3px;top:-4px;background:#191919;color:white;
  border-radius:50%;min-width:17px;height:17px;font-size:10px;display:grid;place-items:center}
.menu-toggle{display:none}
.hero{padding:28px 0 56px}
.hero-card{position:relative;min-height:510px;border-radius:28px;overflow:hidden;
  background:#e9e0d6;display:grid;grid-template-columns:1fr 1fr}
.hero-copy{padding:clamp(30px,6vw,82px);display:flex;flex-direction:column;
  justify-content:center;align-items:flex-start;position:relative;z-index:2}
.eyebrow{font-size:10px;letter-spacing:3px;text-transform:uppercase;
  font-weight:700;color:var(--accent)}
.hero h1{font-family:Georgia,serif;font-size:clamp(40px,5.3vw,72px);
  line-height:1.04;letter-spacing:-2px;font-weight:400;margin:20px 0}
.hero h1 em{font-weight:400;color:#8a6447}
.hero-copy p{max-width:390px;color:#61564c;font-size:14px}
.btn{border:0;border-radius:999px;padding:14px 23px;display:inline-flex;
  align-items:center;justify-content:center;gap:9px;font-size:12px;
  font-weight:700;transition:transform .2s,background .2s}
.btn:hover{transform:translateY(-2px)}
.btn-dark{background:#191919;color:white}
.btn-light{background:white;color:#191919;border:1px solid var(--line)}
.hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:23px}
.hero-visual{position:relative;min-height:350px;overflow:hidden}
.hero-visual img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover;
  object-position:center;mix-blend-mode:multiply}
.hero-stamp{position:absolute;right:22px;bottom:22px;width:100px;height:100px;
  background:#faf8f5e8;border-radius:50%;display:grid;place-items:center;
  text-align:center;font:italic 14px Georgia,serif;transform:rotate(9deg)}
.benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:20px}
.benefit{background:var(--paper);border:1px solid var(--line);border-radius:16px;
  padding:19px;display:flex;align-items:center;gap:12px}
.benefit .symbol{width:39px;height:39px;border-radius:50%;background:var(--soft);
  display:grid;place-items:center;font-size:17px;flex-shrink:0}
.benefit strong{display:block;font-size:12px}
.benefit span{font-size:11px;color:var(--muted)}
.section{padding:48px 0}
.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:24px}
.section-head h2,.editorial h2,.contact h2{font:400 clamp(30px,4vw,45px)/1.1 Georgia,serif;
  letter-spacing:-1px;margin:7px 0}
.section-head p{margin:0;color:var(--muted);font-size:12px}
.catalog-tools{display:flex;justify-content:space-between;align-items:center;
  flex-wrap:wrap;gap:12px;margin:25px 0}
.tabs{display:flex;gap:7px;flex-wrap:wrap}
.tab{padding:10px 17px;border:1px solid var(--line);background:transparent;
  border-radius:999px;font-size:11px;font-weight:700;color:#6c665f}
.tab.active,.tab:hover{background:#191919;color:white;border-color:#191919}
.search-sort{display:flex;gap:8px;flex-wrap:wrap}
.searchbox{display:flex;align-items:center;gap:9px;background:white;
  border:1px solid var(--line);border-radius:999px;padding:0 15px;min-width:220px}
.searchbox input{width:100%;min-width:0;border:0;outline:0;background:transparent;
  padding:12px 0;font-size:12px}
select{background:white;border:1px solid var(--line);border-radius:999px;
  padding:12px 14px;font-size:11px;color:#5e5852;max-width:100%}
.catalog-meta{font-size:11px;color:var(--muted);margin-bottom:14px}
.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px 15px}
.product{min-width:0;cursor:pointer;animation:rise .45s both}
@keyframes rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
.product-photo{position:relative;aspect-ratio:3/4;border-radius:17px;overflow:hidden;
  background:#eee8e1}
.product-photo img{width:100%;height:100%;object-fit:cover;transition:transform .55s}
.product:hover .product-photo img{transform:scale(1.045)}
.pill{position:absolute;top:11px;left:10px;background:#fffdf8eF;
  border-radius:999px;padding:6px 10px;font-size:9px;letter-spacing:.6px}
.favorite{position:absolute;right:10px;top:10px;width:35px;height:35px;border:0;
  border-radius:50%;background:#fffdf8ed;font-size:19px;display:grid;place-items:center}
.favorite.saved{color:#b65b62}
.quickview{position:absolute;left:10px;right:10px;bottom:10px;background:#fff;
  border:0;border-radius:999px;padding:12px;font-size:10px;font-weight:700;
  opacity:0;transform:translateY(6px);transition:.25s}
.product:hover .quickview,.quickview:focus{opacity:1;transform:none}
.product-info{padding:12px 3px 0}
.product-info small{font-size:9px;text-transform:uppercase;letter-spacing:1.4px;color:var(--accent)}
.product-info h3{font-size:13px;font-weight:600;margin:4px 0 3px}
.product-info p{font-size:11px;color:var(--muted);margin:0}
.empty{grid-column:1/-1;text-align:center;padding:55px 15px;background:white;
  border:1px solid var(--line);border-radius:18px;color:var(--muted)}
.empty strong{display:block;color:var(--ink);font:26px Georgia,serif;margin-bottom:7px}
.editorial{padding:25px 0 65px}
.editorial-inner{background:#e9e0d6;border-radius:26px;display:grid;
  grid-template-columns:1fr 1fr;overflow:hidden;min-height:340px}
.editorial-copy{padding:clamp(28px,5vw,65px);display:flex;flex-direction:column;
  justify-content:center;align-items:flex-start}
.editorial-copy p{max-width:410px;color:#64574c;font-size:13px}
.editorial-image{min-height:260px;background:#d6c7b8;overflow:hidden}
.editorial-image img{width:100%;height:100%;object-fit:cover}
.contact{padding:55px 0}
.contact-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:24px}
.contact-copy{background:#191919;color:white;border-radius:24px;padding:clamp(26px,4vw,48px)}
.contact-copy .eyebrow{color:#d7b99c}
.contact-copy p{color:#c8c2bb;font-size:13px}
.contact-line{border-top:1px solid #ffffff24;padding:16px 0;display:flex;gap:13px;
  align-items:flex-start;font-size:12px}
.contact-line b{display:block;font-size:12px;margin-bottom:4px}
.contact-line span{color:#c8c2bb}
.contact-symbol{font-size:19px}
.map-card{background:white;border:1px solid var(--line);border-radius:24px;
  overflow:hidden;display:flex;flex-direction:column}
.map-title{padding:25px 25px 14px}
.map-title h3{font:27px Georgia,serif;margin:4px 0}
.map-title p{font-size:12px;color:var(--muted);margin:0}
.map-frame{width:100%;height:300px;border:0;flex:1;min-height:240px}
.map-actions{padding:15px;display:flex;gap:8px;flex-wrap:wrap}
.socials{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
.social-link{border:1px solid #ffffff45;border-radius:999px;padding:10px 15px;font-size:11px}
footer{background:#f0ebe5;border-top:1px solid var(--line);padding:27px 0}
.footer-inner{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}
.footer-brand{font:25px Georgia,serif;letter-spacing:2px}
footer p{font-size:10px;color:var(--muted);margin:4px 0}
.footer-links{display:flex;gap:17px;font-size:11px;flex-wrap:wrap}
.modal{position:fixed;inset:0;z-index:60;background:#15120fe0;display:none;
  align-items:center;justify-content:center;padding:18px}
.modal.open{display:flex}
.modal-box{width:min(850px,100%);max-height:92vh;overflow:auto;background:var(--bg);
  border-radius:23px;position:relative}
.modal-close{position:absolute;right:12px;top:12px;z-index:2;width:40px;height:40px;
  border:0;border-radius:50%;background:white;font-size:22px}
.modal-content{display:grid;grid-template-columns:1fr 1fr}
.modal-image{background:#eee8e1;min-height:300px}
.modal-image img{width:100%;height:100%;min-height:300px;max-height:75vh;object-fit:contain}
.modal-info{padding:clamp(23px,4vw,45px);display:flex;flex-direction:column;justify-content:center}
.modal-info h2{font:36px Georgia,serif;margin:12px 0}
.modal-info p{font-size:13px;color:var(--muted)}
.modal-info .btn{margin-top:15px}
.toast{position:fixed;bottom:20px;left:50%;transform:translate(-50%,20px);
  background:#191919;color:white;border-radius:999px;padding:12px 19px;
  font-size:12px;opacity:0;pointer-events:none;transition:.25s;z-index:100}
.toast.show{opacity:1;transform:translate(-50%,0)}
.mobile-menu{display:none}
@media(max-width:850px){
 .navlinks{gap:14px}.hero-card{min-height:420px}.hero-copy{padding:30px}
 .grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:20px 12px}
 .quickview{opacity:1;transform:none}.contact-grid{grid-template-columns:1fr}
}
@media(max-width:620px){
 .announcement{font-size:9px;letter-spacing:1px}
 .nav{min-height:67px}.brand img{width:78px;height:48px}
 .menu-toggle{display:grid}
 .navlinks{display:none}
 .mobile-menu{position:absolute;top:100%;left:0;right:0;background:var(--bg);
   padding:14px 5% 20px;border-bottom:1px solid var(--line);gap:0}
 .mobile-menu.open{display:grid}
 .mobile-menu a{padding:13px 4px;border-bottom:1px solid var(--line);font-size:13px}
 .hero{padding:15px 0 28px}
 .hero-card{grid-template-columns:1fr;min-height:0;border-radius:21px}
 .hero-copy{padding:31px 25px 26px}
 .hero h1{font-size:46px;margin:13px 0;letter-spacing:-1.7px}
 .hero-copy p{font-size:13px}
 .hero-visual{min-height:280px;max-height:350px}
 .hero-stamp{width:78px;height:78px;font-size:12px}
 .benefits{grid-template-columns:1fr;gap:8px;margin-top:12px}
 .benefit{padding:12px 15px}
 .section{padding:35px 0}
 .section-head{align-items:flex-start;flex-direction:column;gap:7px;margin-bottom:17px}
 .catalog-tools{margin:18px 0;align-items:stretch}
 .tabs{flex-wrap:nowrap;overflow:auto;padding-bottom:4px}
 .tab{white-space:nowrap;padding:10px 14px}
 .search-sort{width:100%}.searchbox{flex:1;min-width:0}
 .search-sort select{max-width:125px}
 .grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 10px}
 .product-photo{border-radius:13px}
 .favorite{width:32px;height:32px;right:7px;top:7px}
 .product-info h3{font-size:12px}
 .product-info p{font-size:10px}
 .editorial{padding:15px 0 35px}
 .editorial-inner{grid-template-columns:1fr}
 .editorial-copy{padding:30px 24px}
 .editorial-image{min-height:260px;max-height:360px}
 .contact{padding:30px 0}
 .contact-copy{border-radius:19px}
 .map-card{border-radius:19px}
 .map-frame{height:260px}
 .modal-content{grid-template-columns:1fr}
 .modal-image{min-height:250px;max-height:45vh}
 .modal-image img{min-height:250px;max-height:45vh}
 .modal-info{padding:23px}
 .modal-info h2{font-size:29px}
 .footer-inner{align-items:flex-start;flex-direction:column}
}
@media(prefers-reduced-motion:reduce){
 *,*::before,*::after{scroll-behavior:auto!important;animation:none!important;transition:none!important}
}
</style>
</head>
<body>
<div class="announcement">GSTORE · MODA QUE VALORIZA VOCÊ · CEARÁ-MIRIM/RN</div>

<header>
  <div class="container nav">
    <button class="iconbtn menu-toggle" id="menuToggle" aria-label="Abrir menu">☰</button>
    <a class="brand" href="#inicio" aria-label="GStore início">
      <img src="public/images/Logo.png" alt="Logo GStore"
        onerror="this.style.display='none';this.parentElement.insertAdjacentHTML('beforeend','<strong style=&quot;font:25px Georgia;letter-spacing:2px&quot;>GSTORE</strong>')">
    </a>
    <nav class="navlinks" aria-label="Menu principal">
      <a href="#inicio">Início</a><a href="#produtos">Coleção</a>
      <a href="#sobre">Nossa essência</a><a href="#contato">Contato</a>
    </nav>
    <div class="navright">
      <button class="iconbtn" id="headerSearch" aria-label="Pesquisar">⌕</button>
      <button class="iconbtn" id="headerFavorites" aria-label="Ver favoritos">♡
        <span class="count" id="favoriteCount">0</span>
      </button>
    </div>
  </div>
  <nav class="mobile-menu" id="mobileMenu" aria-label="Menu móvel">
    <a href="#inicio">Início</a><a href="#produtos">Coleção completa</a>
    <a href="#sobre">Nossa essência</a><a href="#contato">Contato e localização</a>
  </nav>
</header>

<main>
<section class="hero container" id="inicio">
  <div class="hero-card">
    <div class="hero-copy">
      <span class="eyebrow">Seu estilo, sua identidade</span>
      <h1>Vista-se de<br><em>confiança.</em></h1>
      <p>Peças especiais para acompanhar sua personalidade, valorizar sua beleza e transformar cada look em uma expressão de quem você é.</p>
      <div class="hero-actions">
        <a class="btn btn-dark" href="#produtos">Explorar coleção <span>↗</span></a>
        <a class="btn btn-light" href="#contato">Visite nossa loja</a>
      </div>
    </div>
    <div class="hero-visual">
      <img id="heroImage" src="public/images/gstore_cm_20261025_002803142.jpg"
        alt="Peça da coleção GStore" onerror="this.style.display='none'">
    </div>
  </div>
  <div class="benefits">
    <div class="benefit"><div class="symbol">✧</div><div><strong>Peças selecionadas</strong><span>Looks que destacam sua beleza</span></div></div>
    <div class="benefit"><div class="symbol">♡</div><div><strong>Novidades toda semana</strong><span>Sempre um novo jeito de combinar</span></div></div>
    <div class="benefit"><div class="symbol">⌖</div><div><strong>Estamos pertinho</strong><span>Ceará-Mirim, Rio Grande do Norte</span></div></div>
  </div>
</section>

<section class="section container" id="produtos">
  <div class="section-head">
    <div><span class="eyebrow">Encontre seu próximo look</span><h2>Explore a GStore</h2>
    <p>Descubra as peças da nossa coleção e escolha as suas favoritas.</p></div>
  </div>
  <div class="catalog-tools">
    <div class="tabs" role="group" aria-label="Filtros de coleção">
      <button class="tab active" data-filter="all">Todas as peças</button>
      <button class="tab" data-filter="new">Novidades</button>
      <button class="tab" data-filter="favorites">♡ Favoritos</button>
    </div>
    <div class="search-sort">
      <label class="searchbox"><span>⌕</span>
        <input type="search" id="searchInput" placeholder="Buscar peça..." aria-label="Buscar produtos">
      </label>
      <select id="sortSelect" aria-label="Ordenar produtos">
        <option value="default">Ordem original</option>
        <option value="az">Nome A–Z</option>
        <option value="za">Nome Z–A</option>
      </select>
    </div>
  </div>
  <div class="catalog-meta" id="catalogMeta" aria-live="polite">Carregando coleção...</div>
  <div class="grid" id="productGrid"></div>
</section>

<section class="editorial container" id="sobre">
  <div class="editorial-inner">
    <div class="editorial-copy">
      <span class="eyebrow">Nossa história · Desde 2022</span>
      <h2>Quem somos?</h2>
      <p><strong>A G Store Multimarcas</strong> nasceu dos grandes sonhos e da determinação da Gê. Em 2022, começamos nossa jornada no ambiente online, com o propósito de tornar a experiência de compra mais prática, acessível e especial.</p>
      <p>Com o crescimento da demanda e, principalmente, com o carinho e a confiança dos nossos clientes, demos um novo passo: a inauguração da nossa loja física, na Rua General João Varela, nº 768, em Ceará-Mirim.</p>
      <p>Oficialmente fundada em <strong>15 de agosto de 2025</strong>, a G Store Multimarcas tem como missão oferecer produtos de qualidade, preços competitivos e um atendimento que faça cada cliente se sentir valorizado.</p>
      <p>Acreditamos que cada conquista é construída junto com quem escolhe a nossa marca. Por isso, trabalhamos todos os dias para superar expectativas, fortalecer relações e levar mais estilo e confiança a cada pessoa.</p>
      <div class="story-signature">G Store Multimarcas <span>— moda com propósito, carinho em cada detalhe.</span></div>
      <a href="#contato" class="btn btn-dark">Venha nos conhecer ↗</a>
    </div>
    <div class="editorial-image">
      <img id="editorialImage" src="public/images/gstore_cm_20261025_002805993.jpg"
        alt="Seleção de moda GStore" loading="lazy" onerror="this.style.display='none'">
    </div>
  </div>
</section>

<section class="contact container" id="contato">
  <div class="section-head">
    <div><span class="eyebrow">Vamos nos encontrar?</span><h2>Estamos esperando você.</h2>
    <p>Conheça a loja, confira as novidades e fale com a GStore.</p></div>
  </div>
  <div class="contact-grid">
    <div class="contact-copy">
      <span class="eyebrow">GStore · Ceará-Mirim</span>
      <h2>Seu próximo look<br>está por aqui.</h2>
      <p>Venha conhecer nossas peças pessoalmente ou acompanhe as novidades pelas nossas redes.</p>
      <div class="contact-line"><span class="contact-symbol">⌖</span><div><b>Nosso endereço</b><span>Rua General João Varela, 768<br>Ceará-Mirim – RN<br>CEP 59570-000, Brasil</span></div></div>
      <div class="contact-line"><span class="contact-symbol">◷</span><div><b>Novidades toda semana</b><span>Acompanhe nossas publicações para conhecer as novas peças.</span></div></div>
      <div class="socials">
        <a class="social-link social-icon" id="instagramLink"
          href="https://www.instagram.com/" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.6" cy="6.7" r="1.15" fill="currentColor"/></svg>
          Instagram <span>↗</span>
        </a>
        <a class="social-link social-icon" id="whatsappLink"
          href="https://wa.me/?text=Olá%21%20Gostaria%20de%20conhecer%20as%20peças%20da%20GStore."
          target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.5 3.5A11.8 11.8 0 0 0 2 17.7L.4 23.5l6-1.6A11.8 11.8 0 0 0 20.5 3.5ZM12 21a9.7 9.7 0 0 1-4.9-1.3l-.4-.2-3.6 1 1-3.5-.3-.5A9.7 9.7 0 1 1 12 21Zm5.3-7.3c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2-.8 1-1 1.1-.3.2-.6.1a8 8 0 0 1-2.4-1.5 9 9 0 0 1-1.7-2.1c-.2-.3 0-.5.1-.6l.5-.6.2-.5c.1-.2 0-.4 0-.6l-1-2.3c-.3-.6-.6-.5-.8-.5h-.6a1.2 1.2 0 0 0-.9.4 3.7 3.7 0 0 0-1.1 2.7 6.4 6.4 0 0 0 1.3 3.4 14.5 14.5 0 0 0 5.6 5c.7.3 1.2.5 1.6.6a3.9 3.9 0 0 0 1.8.1 3 3 0 0 0 2-1.4 2.5 2.5 0 0 0 .2-1.4c-.1-.2-.3-.3-.6-.5Z"/></svg>
          WhatsApp <span>↗</span>
        </a>
        <a class="social-link" href="#produtos">Ver coleção ↗</a>
      </div>
    </div>
    <div class="map-card">
      <div class="map-title"><span class="eyebrow">Como chegar</span><h3>Encontre nossa loja</h3>
      <p>Rua General João Varela, 768 · Ceará-Mirim, RN</p></div>
      <iframe class="map-frame"
